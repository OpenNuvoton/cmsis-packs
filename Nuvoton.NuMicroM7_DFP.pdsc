          <memory id="IROM2" start="0x10800000" size="0x10000" startup="0" default="0"/>
          <memory id="IRAM1" start="0x20000000" size="0x0C000" init="0"    default="1"/>
          <memory id="IRAM2" start="0x00000000" size="0x10000" init="0"    default="0"/>

           <algorithm name="Flash/KM1M7BFxxx_I.FLM" start="0x00800000" size="0x60000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 
           <algorithm name="Flash/KM1M7BFxxx_D.FLM" start="0x10800000" size="0x10000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 

        </device>

        <!-- ****************  Device "KM1M7BF00K"  **************** -->
        <device Dname = "KM1M7BF00K">
          <compile header="Device/KM1M7BF/Include/KM1M7BF00x.h"/>
          <compile header="Device/KM1M7BF/Include/KM1M7BF00x_regdef.h"/>
          <debug svd="SVD/KM1M7BF00x.svd"/>

          <memory id="IROM1" start="0x00800000" size="0x40000" startup="1" default="1"/>
          <memory id="IROM2" start="0x10800000" size="0x10000" startup="0" default="0"/>
          <memory id="IRAM1" start="0x20000000" size="0x08000" init="0"    default="1"/>
          <memory id="IRAM2" start="0x00000000" size="0x10000" init="0"    default="0"/>

           <algorithm name="Flash/KM1M7BFxxx_I.FLM" start="0x00800000" size="0x40000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 
           <algorithm name="Flash/KM1M7BFxxx_D.FLM" start="0x10800000" size="0x10000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 

        </device>

        <!-- ****************  Device "KM1M7BF02N"  **************** -->
        <device Dname = "KM1M7BF02N">
          <compile header="Device/KM1M7BF/Include/KM1M7BF02x.h"/>
