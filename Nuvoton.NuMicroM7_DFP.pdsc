      <subFamily DsubFamily="KM1M7B">
        <processor Dcore="Cortex-M7" DcoreVersion="r1p1" Dfpu="DP_FPU" Dmpu="MPU" Dendian="Little-endian" Dclock="160000000"/>
        <description>
The KM1M7B Series is a 32-bit micro controller with internal Flash memory.
It is intended for development of the C programming language with object-oriented program and is easy to use.
It has fast feedback processing required for control of power supply and motor.
This LSI adopts the Arm Cortex-M7 to the 32-bit microcontroller part.
        </description>

        <!-- ****************  Keycode File  **************** -->
        <debugvars configfile="Device/KM1M7BF/Option/Keyfile.dbgconf" version="1.0">
          __var KeyfileEnable = 0;

          __var Keycode0   = 0xFFFFFFFF;
          __var Keycode1   = 0xFFFFFFFF;
          __var Keycode2   = 0xFFFFFFFF;
          __var Keycode3   = 0xFFFFFFFF;
        </debugvars>

        <!-- ****************  Sequence for connect sequence  **************** -->
        <sequences>
          <sequence name="ResetHardwareAssert">
            <block>
               __var nReset = 0x80;
              // De-assert nRESET line to activate the hardware reset
              DAP_SWJ_Pins(0, nReset, 0);
            </block>
            <block>
              DAP_Delay(100000);
            </block>
          </sequence>

          <sequence name="DebugDeviceUnlock">
            <block>
              <!-- Query(0, "  ==== DebugDeviceUnlock()", 1); -->
              sequence("DisableWDT");
            </block>

            <block>
              sequence("UnlockDAP");
            </block>

            <block>
              <!-- DebugCoreStart ARM Original -->
              <!-- Debug enable                -->
              <!--   - DHCSR.C_DEBUGEN = 1     -->
              Write32(0xE000EDF0, 0xA05F0001);
            </block>

            <block>
              <!-- ResetCatchSet ARM Original -->
              <!-- Enable Reset Vector Catch. -->
              <!--   - DEMCR.VC_CORERESET = 1 -->
              __var rdata = 0;
              rdata = Read32(0xE000EDFC);
              Write32(0xE000EDFC, (rdata | 0x00000001));
            </block>

            <block>
              <!-- Read DHCSR to clear potentially set DHCSR.S_RESET_ST bit -->
              Read32(0xE000EDF0);
            </block>

            <block>
              __var nReset      = 0x80;
              __var canReadPins = 0;

              // Assert nRESET line and check if nRESET is readable
              canReadPins = (DAP_SWJ_Pins(nReset, nReset, 0) != 0xFFFFFFFF);
            </block>

            <!-- Wait max. 1s for nRESET to recover from reset if readable-->
            <control if="canReadPins" while="(DAP_SWJ_Pins(nReset, nReset, 0) &amp; nReset) == 0" timeout="1000000"/>

            <!-- Wait 100ms for recovery if nRESET not readable -->
            <control if="!canReadPins" while="1" timeout="100000"/>

            <block>
              DAP_Delay(1000000);
            </block>
          </sequence>

          <sequence name="DisableWDT">
            <block>
              __var rdata = 0;

              rdata = Read32(0xF0102010);
              rdata = rdata | 0x672C0004;
              Write32(0xF0102010, rdata);
            </block>
          </sequence>

          <sequence name="UnlockDAP">
            <control if="KeyfileEnable == 1">
              <block>
                Write32(0xF0102000, Keycode0);
                Write32(0xF0102004, Keycode1);
                Write32(0xF0102008, Keycode2);
                Write32(0xF010200C, Keycode3);
              </block>
            </control>
          </sequence>
        </sequences>

        <!-- ****************  Device "KM1M7BF00N"  **************** -->
        <device Dname = "KM1M7BF00N">
          <compile header="Device/KM1M7BF/Include/KM1M7BF00x.h"/>
          <compile header="Device/KM1M7BF/Include/KM1M7BF00x_regdef.h"/>
          <debug svd="SVD/KM1M7BF00x.svd"/>

          <memory id="IROM1" start="0x00800000" size="0x80000" startup="1" default="1"/>
          <memory id="IROM2" start="0x10800000" size="0x10000" startup="0" default="0"/>
          <memory id="IRAM1" start="0x20000000" size="0x10000" init="0"    default="1"/>
          <memory id="IRAM2" start="0x00000000" size="0x10000" init="0"    default="0"/>

           <algorithm name="Flash/KM1M7BFxxx_I.FLM" start="0x00800000" size="0x80000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 
           <algorithm name="Flash/KM1M7BFxxx_D.FLM" start="0x10800000" size="0x10000" RAMstart="0x20000000"  RAMsize="0x4000"  default="1"/> 

        </device>

