  <releases>
    <release version="1.0.4" date="2026-07-03">
      Add stddriver files.
    </release>
    <release version="1.0.3" date="2026-02-11">
      Add M3333/M3334 part no.
    </release>
    <release version="1.0.2" date="2025-12-18">
      Add M3351 series.
    </release>
    <release version="1.0.1" date="2025-09-10">
      1. Add new part no.
      2. Update IROM and RAMStart for flash algorithm.
    </release>
    <release version="1.0.0" date="2025-07-15">
      Initial Version.
    </release>
  </releases>
