  <conditions>
    <!-- conditions are dependecy rules that can apply to a component or an individual file -->
    <condition id="Compiler ARM">
      <!-- conditions selecting ARM Compiler -->
      <accept Tcompiler="ARMCC"/>
    </condition>

    <condition id="M4NuMicro M433 Device">
      <description>Nuvoton M4NuMicro M433 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="M433[LS]E8AE"/>
    </condition>
    <condition id="M4NuMicro M451 Device">
      <description>Nuvoton M4NuMicro M451 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="M45[123][VRLSY][EGDC][36]AE"/>
