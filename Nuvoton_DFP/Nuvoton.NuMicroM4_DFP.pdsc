  <components>
    <!-- *************************  Startup file  ***************************** -->
    <component Cclass="Device" Cgroup="Startup" Cversion="0.00.001" condition="M4NuMicro M433 Device">
      <!-- Cversion is necessary -->
      <description>System Startup for Nuvoton M433 Series</description>
      <RTE_Components_h>
        <!-- the following content goes into file 'RTE_Components.h' -->
      </RTE_Components_h>
      <files>
        <!-- header path -->
        <file category="include" name="Device/M433/StdDriver/inc/"/>
        <file category="include" name="Device/M433/Include/"/>
        <file category="header"  name="Device/M433/Include/M433.h"/>
        <!-- startup/system files -->
        <file category="sourceAsm"  name="Device/M433/Source/ARM/startup_M433.s" attr="config" version="0.00.001" condition="Compiler ARM"/>
        <file category="source"  name="Device/M433/Source/system_M433.c" attr="config" version="0.00.001"/>
        <!-- retarget files -->
        <file category="sourceC" name="Device/M433/StdDriver/src/retarget.c" attr="config" version="0.00.001"/>
      </files>
    </component>
