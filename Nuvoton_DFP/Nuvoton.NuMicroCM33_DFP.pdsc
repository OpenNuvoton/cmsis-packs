  <conditions>
    <!-- conditions are dependecy rules that can apply to a component or an individual file -->
    <condition id="Compiler ARM">
      <!-- conditions selecting ARM Compiler -->
      <require Tcompiler="ARMCC"/>
    </condition>

    <condition id="M33NuMicro CM3031 Device">
      <description>Nuvoton M33NuMicro CM3031 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="CM303[34][GH][SNLJ][38]AE"/>
    </condition>
  </conditions>

  <components>
    <!-- *************************  Startup file  ***************************** -->
    <component Cclass="Device" Cgroup="Startup" Cversion="0.00.001" condition="M33NuMicro CM3031 Device">
      <!-- Cversion is necessary -->
      <description>System Startup for Nuvoton CM3031 Series</description>
      <RTE_Components_h>
        <!-- the following content goes into file 'RTE_Components.h' -->
      </RTE_Components_h>
      <files>
        <!-- header path -->
        <file category="include" name="Device/CM3031/StdDriver/inc/"/>
        <file category="include" name="Device/CM3031/Include/"/>
        <file category="header"  name="Device/CM3031/Include/cm3031.h"/>
        <file category="header"  name="Device/CM3031/Include/NuMicro.h"/>
        <file category="header"  name="Device/CM3031/Include/system_cm3031.h"/>
        <!-- startup/system files -->
        <file category="source"  name="Device/CM3031/Source/startup_cm3031.c" attr="config" version="0.00.001"/>
        <file category="source"  name="Device/CM3031/Source/system_cm3031.c" attr="config" version="0.00.001"/>
        <!-- retarget files -->
        <file category="sourceC" name="Device/CM3031/StdDriver/src/retarget.c" attr="config" version="0.00.001"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="StdDriver" Csub="ACMP" Cversion="0.00.001" condition="M33NuMicro CM3031 Device">
      <description>ACMP driver for Nuvoton CM3031 series</description>
      <files>
        <file category="header" name="Device/CM3031/StdDriver/inc/acmp.h"/>
        <file category="sourceC" name="Device/CM3031/StdDriver/src/acmp.c"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="StdDriver" Csub="BPWM" Cversion="0.00.001" condition="M33NuMicro CM3031 Device">
      <description>BPWM driver for Nuvoton CM3031 series</description>
      <files>
        <file category="header" name="Device/CM3031/StdDriver/inc/bpwm.h"/>
        <file category="sourceC" name="Device/CM3031/StdDriver/src/bpwm.c"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="StdDriver" Csub="CANFD" Cversion="0.00.001" condition="M33NuMicro CM3031 Device">
      <description>CANFD driver for Nuvoton CM3031 series</description>
