  <conditions>
    <!-- conditions are dependecy rules that can apply to a component or an individual file -->
    <condition id="Compiler ARM">
      <!-- conditions selecting ARM Compiler -->
      <accept Tcompiler="ARMCC"/>
    </condition>

    <condition id="M23NuMicro CM2003 Device">
      <description>Nuvoton M23NuMicro CM2003 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="CM2003[CEG][FNLJ][238]AE"/>
    </condition>
    <condition id="M23NuMicro CM2052 Device">
      <description>Nuvoton M23NuMicro CM2052 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="CM2052E[LN]8AE"/>
    </condition>
    <condition id="M23NuMicro CM2053 Device">
      <description>Nuvoton M23NuMicro CM2053 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="CM2053EL8AE"/>
    </condition>
    <condition id="M23NuMicro CM2U51 Device">
      <description>Nuvoton M23NuMicro CM2U51 Series devices</description>
      <accept Dvendor="Nuvoton:18"  Dname="CM2U5[14][DEG][SLNQ][38]AE"/>
    </condition>
  </conditions>

  <components>
    <!-- *************************  Startup file  ***************************** -->
    <component Cclass="Device" Cgroup="Startup" Cversion="0.00.001" condition="M23NuMicro CM2003 Device">
